<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>SoftResult</RootNamespace>
        <Version>1.5.10.1</Version>
        <Authors>Artem Konkin, Ekaterina Volodina, Anastasiya Lugovaya, Adilet Akunov</Authors>
        <Company>Salyk Service</Company>
        <Description>Библиотека для обработки результатов операций с удобным API</Description>
        <PackageTags>SoftResult;Lib;Library;Result;ErrorHandling;ResultPattern;C#;NET</PackageTags>
        <LangVersion>latest</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>true</IsPackable>
        <EnableDefaultStaticWebAssets>false</EnableDefaultStaticWebAssets>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <Title>Soft Result</Title>
        <Copyright>DIWOS</Copyright>
        <PackageProjectUrl>https://github.com/DIWOS-Projects/soft-result</PackageProjectUrl>
        <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageIcon>icon.png</PackageIcon>
        <RepositoryUrl>https://github.com/DIWOS-Projects/soft-result</RepositoryUrl>
        <RepositoryType>Github</RepositoryType>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <PackageReleaseNotes>

            ✨ Новые возможности (Features)

            * Обновление до .NET 10.0

        </PackageReleaseNotes>
        <RunPostBuildEvent>Always</RunPostBuildEvent>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <DebugType>portable</DebugType>
        <DebugSymbols>true</DebugSymbols>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\README.md" Pack="true" PackagePath="\" />
        <None Include="LICENSE" Pack="true" PackagePath="\" />
        <None Include="icon.png" Pack="true" PackagePath="\" />
    </ItemGroup>

</Project>